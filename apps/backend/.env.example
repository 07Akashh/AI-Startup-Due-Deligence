# Server Configuration
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/startupai?schema=public

# Authentication
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# AI Provider: 'openrouter' | 'openai' | 'groq'
AI_PROVIDER=openrouter
EMBEDDING_PROVIDER=openai

# OpenRouter Configuration (Multi-Model Agent Routing)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Reasoning Agent (CoT Investment Memo & Scoring)
OPENROUTER_REASONING_MODEL=deepseek/deepseek-r1:free
# Extraction & Parsing Agent
OPENROUTER_EXTRACTION_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Knowledge & RAG Market Research Agent
OPENROUTER_KNOWLEDGE_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Validator Agent (Strict Math & Logic Validation at temp 0.0)
OPENROUTER_VALIDATOR_MODEL=qwen/qwen-2.5-72b-instruct:free
# Fallback models
OPENROUTER_MINI_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FULL_MODEL=deepseek/deepseek-r1:free

# OpenAI Configuration (Alternative)
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MINI_MODEL=gpt-4o-mini
OPENAI_FULL_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq Configuration (Alternative)
GROQ_API_KEY=gsk_your-groq-key
GROQ_MINI_MODEL=llama-3.1-8b-instant
GROQ_FULL_MODEL=llama-3.3-70b-versatile

# Jina AI Embeddings (Optional)
JINA_API_KEY=jina_your-key
JINA_EMBEDDING_MODEL=jina-embeddings-v3

# Pinecone Vector Store
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=startupai-due-diligence
PINECONE_ENVIRONMENT=us-east-1

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=

# Redis (Optional Caching)
REDIS_URL=redis://localhost:6379
